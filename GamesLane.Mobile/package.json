{
  "name": "gameslane-mobile",
  "version": "1.0.0",
  "description": "GamesLane iPhone and Android apps (Capacitor)",
  "scripts": {
    "sync": "cap sync ios",
    "open": "cap open ios",
    "ios": "cap sync ios && cap open ios",
    "simulator": "cap sync ios && cap run ios",
    "sync:android": "cap sync android",
    "android": "cap sync android && cap open android",
    "emulator": "cap sync android && cap run android",
    "assets": "capacitor-assets generate --ios --iconBackgroundColor '#f5f1ea' --splashBackgroundColor '#f5f1ea' --splashBackgroundColorDark '#f5f1ea'",
    "assets:android": "capacitor-assets generate --android --iconBackgroundColor \"#f5f1ea\" --splashBackgroundColor \"#f5f1ea\" --splashBackgroundColorDark \"#f5f1ea\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module"
}
